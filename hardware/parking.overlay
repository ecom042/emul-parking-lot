/ {
        zephyr,user {
                /* Entry lane: camera USART3, distance ADC4 IN17 (PD13). */
                entry-enable-gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
                entry-direction-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
                entry-upper-gpios = <&gpioc 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                entry-lower-gpios = <&gpioc 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                entry-obstruction-gpios = <&gpioc 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                entry-red-gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>;
                entry-green-gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
                entry-buzzer-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;
                /* Exit lane: camera USART2, payment LPUART1, ADC4 IN18 (PB0). */
                exit-enable-gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
                exit-direction-gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
                exit-upper-gpios = <&gpioc 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                exit-lower-gpios = <&gpioc 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                exit-obstruction-gpios = <&gpioc 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
                exit-red-gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
                exit-green-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
                exit-buzzer-gpios = <&gpiod 3 GPIO_ACTIVE_HIGH>;
                /* Exit-lane payment display. */
                dc-gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
                reset-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
        };
};
&adc1 { status = "disabled"; };
&adc4 { pinctrl-0 = <&adc4_in17_pd13 &adc4_in18_pb0>; };
&usart2 { status = "okay"; };
&usart3 {
        pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
        pinctrl-names = "default";
        current-speed = <115200>;
        status = "okay";
};
&lpuart1 { status = "okay"; };
&spi1 {
        status = "okay";
        display_reference: display@0 {
                compatible = "course,st7789v-reference";
                reg = <0>;
                spi-max-frequency = <1000000>;
        };
};
