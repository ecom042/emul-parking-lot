/*
 * Course parking lot controller: an STM32U5A5ZJ with the clock tree of ST's
 * nucleo_u5a5zj_q, trimmed to the console and the lot's equipment. The lot
 * runs only in Renode (hardware/renode/parking.repl wires the models).
 *
 * Firmware reaches every device through an alias, never a pin number:
 *   GPIO_DT_SPEC_GET(DT_ALIAS(entry_motor_enable), gpios)
 *   ADC_CHANNEL_CFG_DT(DT_ALIAS(entry_distance))
 *   DEVICE_DT_GET(DT_ALIAS(entry_camera))
 *
 * Copyright (c) 2023-2024 STMicroelectronics (board base)
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/u5/stm32u5a5Xj.dtsi>
#include <st/u5/stm32u5a5zjtxq-pinctrl.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	model = "Course parking lot controller (STM32U5A5ZJ)";
	compatible = "ufal,parking-lot-u5";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		/* Entry lane */
		entry-motor-enable = &entry_motor_enable;
		entry-motor-direction = &entry_motor_direction;
		entry-limit-upper = &entry_limit_upper;
		entry-limit-lower = &entry_limit_lower;
		entry-beam = &entry_beam;
		entry-light-red = &entry_light_red;
		entry-light-green = &entry_light_green;
		entry-buzzer = &entry_buzzer;
		entry-distance = &adc4_in17;
		entry-camera = &usart3;

		/* Exit lane */
		exit-motor-enable = &exit_motor_enable;
		exit-motor-direction = &exit_motor_direction;
		exit-limit-upper = &exit_limit_upper;
		exit-limit-lower = &exit_limit_lower;
		exit-beam = &exit_beam;
		exit-light-red = &exit_light_red;
		exit-light-green = &exit_light_green;
		exit-buzzer = &exit_buzzer;
		exit-distance = &adc4_in18;
		exit-camera = &usart2;

		/* Payment terminal and its display (exit lane) */
		payment-terminal = &lpuart1;
		payment-display = &payment_display;
	};

	/*
	 * Outputs, active high. "gpio-leds" is only a container for named GPIO
	 * outputs: keep CONFIG_LED off and drive them with gpio_pin_set_dt().
	 */
	motors {
		compatible = "gpio-leds";

		entry_motor_enable: entry_motor_enable {
			gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
			label = "Entry motor enable (active runs)";
		};

		entry_motor_direction: entry_motor_direction {
			gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
			label = "Entry motor direction (active opens)";
		};

		exit_motor_enable: exit_motor_enable {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
			label = "Exit motor enable (active runs)";
		};

		exit_motor_direction: exit_motor_direction {
			gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
			label = "Exit motor direction (active opens)";
		};
	};

	signals {
		compatible = "gpio-leds";

		entry_light_red: entry_light_red {
			gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>;
			label = "Entry red light";
		};

		entry_light_green: entry_light_green {
			gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
			label = "Entry green light";
		};

		entry_buzzer: entry_buzzer {
			gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;
			label = "Entry buzzer";
		};

		exit_light_red: exit_light_red {
			gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
			label = "Exit red light";
		};

		exit_light_green: exit_light_green {
			gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
			label = "Exit green light";
		};

		exit_buzzer: exit_buzzer {
			gpios = <&gpiod 3 GPIO_ACTIVE_HIGH>;
			label = "Exit buzzer";
		};
	};

	/*
	 * Inputs, active high with pull-down, each on its own EXTI line.
	 * "gpio-keys" is only a container for named GPIO inputs: keep
	 * CONFIG_INPUT off, or its driver takes the pins and their interrupts.
	 */
	sensors {
		compatible = "gpio-keys";

		entry_limit_upper: entry_limit_upper {
			gpios = <&gpioc 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Entry upper limit (barrier open, 90 degrees)";
		};

		entry_limit_lower: entry_limit_lower {
			gpios = <&gpioc 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Entry lower limit (barrier closed, 0 degrees)";
		};

		entry_beam: entry_beam {
			gpios = <&gpioc 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Entry passage/obstruction beam";
		};

		exit_limit_upper: exit_limit_upper {
			gpios = <&gpioc 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Exit upper limit (barrier open, 90 degrees)";
		};

		exit_limit_lower: exit_limit_lower {
			gpios = <&gpioc 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Exit lower limit (barrier closed, 0 degrees)";
		};

		exit_beam: exit_beam {
			gpios = <&gpioc 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Exit passage/obstruction beam";
		};
	};
};

/* HSE 16 MHz, PLL1 to 160 MHz system and bus clocks (as on the Nucleo). */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll1 {
	div-m = <4>;
	mul-n = <80>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

/* Diagnostic console */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Entry camera */
&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Exit camera */
&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Payment terminal */
&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pg7 &lpuart1_rx_pg8>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Distance sensors: ADC4 IN17 (entry, PD13) and IN18 (exit, PB0). */
&adc4_common {
	st,adc-prescaler = <4>;
	st,adc-clock-source = "ASYNC";
	status = "okay";
};

&adc4 {
	pinctrl-0 = <&adc4_in17_pd13 &adc4_in18_pb0>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	adc4_in17: channel@11 {
		reg = <17>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	adc4_in18: channel@12 {
		reg = <18>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/* Payment display: ST7789V on SPI1, CS PD14 (active low). */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	payment_display: display@0 {
		compatible = "course,st7789v-reference";
		reg = <0>;
		spi-max-frequency = <1000000>;
		dc-gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
	};
};
