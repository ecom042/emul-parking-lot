sysbus:
    preinit:
        include @../../models/STM32U5_ADC4.cs
        include @../../models/STM32U5_EXTI.cs
        include @../../models/ST7789V.cs
        include @../../models/ParkingPhysical.cs
        include @../../models/ParkingProtocols.cs
        sysbus Unregister "sysbus.adc4"

adcClock: Analog.CourseU5ADCClock @ {
    sysbus new Bus.BusRangeRegistration { address: 0x46020c6c; size: 4; offset: 0x6c };
    sysbus new Bus.BusRangeRegistration { address: 0x46020c94; size: 4; offset: 0x94 };
    sysbus new Bus.BusRangeRegistration { address: 0x46020ce8; size: 4; offset: 0xe8 }
}
    hclkFrequency: 160000000
u5adc4: Analog.CourseSTM32U5ADC4 @ sysbus 0x46021000
    clock: adcClock
    IRQ -> nvic0@113
exti: IRQControllers.CourseSTM32U5EXTI @ sysbus 0x46022000
    [0-15] -> nvic0@[11-26]
gpioc:
    [0-15] -> exti#2@[0-15]

// Exit lane: the original single-lane wiring, plus payment and display.
physicalExit: Miscellaneous.ParkingPhysical @ gpiob 1
    adc: u5adc4
    adcChannel: 18
    lane: "exit"
    0 -> gpioc@2
    1 -> gpioc@3
    2 -> gpioc@4
// Entry lane: same equipment contract, no payment terminal or display.
physicalEntry: Miscellaneous.ParkingPhysical @ gpiob 12
    adc: u5adc4
    adcChannel: 17
    lane: "entry"
    0 -> gpioc@5
    1 -> gpioc@6
    2 -> gpioc@8
gpiob:
    1 -> physicalExit@0
    2 -> physicalExit@1
    12 -> physicalEntry@0
    13 -> physicalEntry@1

protocolsExit: Miscellaneous.ParkingProtocols @ gpiod 1
    camera: usart2
    payment: lpuart1
    lane: "exit"
protocolsEntry: Miscellaneous.ParkingProtocols @ gpioe 2
    camera: usart3
    lane: "entry"
gpiod:
    1 -> protocolsExit@0
    2 -> protocolsExit@1
    3 -> protocolsExit@2
    14 -> display@0
    15 -> display@1
gpioe:
    0 -> display@2
    2 -> protocolsEntry@0
    3 -> protocolsEntry@1
    4 -> protocolsEntry@2
display: Video.CourseST7789V @ spi1
