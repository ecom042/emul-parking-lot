{
  "version": 2, "name": "noisy-threshold", "seed": 12345,
  "deadlines": {"motor_ms": 2500},
  "runs": [
    {
      "duration_ticks": 900,
      "lanes": {
        "entry": {"initial": {"position_mdeg": 0, "vehicle_mm": 1000},
          "green": [{"after_tick": 0, "before_tick": 600}]},
        "exit": {"initial": {"position_mdeg": 0, "vehicle_mm": 6000},
          "green": []}
      },
      "actions": [
        {"at_tick": 1, "kind": "submit", "signal": "sensor.noise", "value": 64, "lane": "entry"}
      ],
      "expect": [
        {"at_tick": 600, "state": {"captures": 1, "vehicle_mm": 1000, "position_mdeg": 90000, "enable": false, "green": true}, "lane": "entry"},
        {"at_tick": 900, "state": {"captures": 1, "green_count": 1, "enable": false}, "lane": "entry"}
      ]
    }
  ]
}
